# Indexación. Bajo NDA: dejar en false hasta el lanzamiento (meta robots + robots.txt + X-Robots-Tag).
NEXT_PUBLIC_ALLOW_INDEXING=false

# URL pública del sitio (Open Graph, sitemap). En Vercel: la del dominio o la de producción.
NEXT_PUBLIC_SITE_URL=https://fosque-reformer-partners.vercel.app

# Envío de leads por email (https://resend.com). Sin estas dos el formulario ofrece WhatsApp.
RESEND_API_KEY=
LEADS_TO_EMAIL=
# Remitente verificado en Resend. Sin dominio propio verificado, Resend sólo permite onboarding@resend.dev.
LEADS_FROM_EMAIL=Fosque Reformer Partners <onboarding@resend.dev>
